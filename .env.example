# =============================================================================
# Stock Data Agentic AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# =============================================================================

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# --- SQL Server Connection ---
SQL_SERVER=192.168.86.55\MSSQLSERVER01
SQL_DATABASE=stockdata_db
SQL_DRIVER={ODBC Driver 17 for SQL Server}
# Use Windows Authentication (leave username/password empty) or SQL Authentication
SQL_USERNAME=
SQL_PASSWORD=
# Set to "yes" for Windows Authentication, "no" for SQL Authentication
SQL_TRUSTED_CONNECTION=yes

# --- Office 365 Email (SMTP) ---
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password-or-app-password
EMAIL_FROM=your-email@yourdomain.com
EMAIL_TO=your-email@yourdomain.com

# --- Standalone report recipients (comma-separated, override per report) ---
# Bucket Tracker / Tomorrow Predictions (ml_bucket_report.py, ml_tomorrow_report.py,
# forex_bucket_report.py, forex_tomorrow_report.py) - shared across markets:
BUCKET_REPORT_EMAIL_TO=your-email@yourdomain.com
# Weekly Stock Screening Report (weekly_screening_report.py) - separate per market:
SCREENING_REPORT_EMAIL_TO_NASDAQ=your-email@yourdomain.com
SCREENING_REPORT_EMAIL_TO_NSE=your-email@yourdomain.com

# --- Agent Configuration ---
# LLM model used by all 8 CrewAI agents + the chat assistant. Switching this one
# value moves the whole platform between models; config/llm_factory.py adapts the
# request parameters automatically (see config/settings.py model profiles).
#   claude-sonnet-4-6  cheap workhorse; accepts temperature; no extended thinking
#   claude-fable-5     most capable; REJECTS temperature (400); thinking always on
# Run `py -3.12 check_model_access.py` to confirm a model is reachable and billable
# before pointing LLM_MODEL at it.
LLM_MODEL=claude-sonnet-4-6
# Optional overrides for the two named models that check_model_access.py probes.
#LLM_MODEL_SONNET=claude-sonnet-4-6
#LLM_MODEL_FABLE=claude-fable-5
# Floor applied to every agent's max_tokens on always-thinking models (fable/opus-5),
# where thinking tokens are billed against the same budget as the visible answer.
#LLM_THINKING_MIN_MAX_TOKENS=8000
# Maximum number of iterations per agent
AGENT_MAX_ITER=5
# Enable verbose logging for debugging
AGENT_VERBOSE=true

# =============================================================================
# Remote Access from Machine B (SQL Server on Machine A)
# =============================================================================
# If running this repo on a different machine from SQL Server, uncomment and
# update the SQL settings above. Replace the SQL_SERVER value with Machine A's
# LAN IP, disable trusted connection, and provide SQL auth credentials:
#
# SQL_SERVER=<MachineA_IP>\MSSQLSERVER01
# SQL_TRUSTED_CONNECTION=no
# SQL_USERNAME=your_sql_login
# SQL_PASSWORD=your_sql_password
